{
  "name": "stableroute-backend",
  "version": "0.1.0",
  "description": "StableRoute API gateway, routing engine, and pricing service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "test:ci": "jest --ci src/__tests__/docs.test.ts src/__tests__/openapi.test.ts src/__tests__/version.test.ts src/__tests__/pricing.test.ts src/__tests__/utils.test.ts src/__tests__/fallback404.test.ts src/__tests__/errorHandler.test.ts src/__tests__/securityHeaders.test.ts src/__tests__/cors.test.ts src/__tests__/parseAmountAssetCode.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "stellar",
    "routing",
    "stablecoin",
    "payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "pino": "^9.6.0",
    "resolve-cwd": "^3.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "js-yaml": "^5.2.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
